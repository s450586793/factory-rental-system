# GHCR deployment reference checklist.
# docker-compose.ghcr.yml is self-contained and can be pasted into Synology GUI directly.
# This file is only for recording the values you plan to substitute in that compose file.

BACKEND_IMAGE=ghcr.io/s450586793/factory-rental-system-backend:latest
FRONTEND_IMAGE=ghcr.io/s450586793/factory-rental-system-frontend:latest

TZ=Asia/Shanghai

POSTGRES_DB=factory_rental
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-password

DB_PORT=5432
DB_NAME=factory_rental
DB_USER=postgres
DB_PASSWORD=replace-with-a-strong-password
DB_SYNCHRONIZE=false

APP_NAME=factory-rental-system
NODE_ENV=production
JWT_SECRET=replace-with-a-long-random-secret
COOKIE_NAME=token
COOKIE_SECURE=true
FRONTEND_ORIGIN=https://your-domain.example.com
API_DOCS_ENABLED=false
PDF_FONT_PATH=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
WEB_UPDATE_ENABLED=false
WEB_UPDATE_DOCKER_SOCKET=/var/run/docker.sock
WEB_UPDATE_PROJECT_DIR=/volume1/docker/factory-rental-system
WEB_UPDATE_COMPOSE_FILES=docker-compose.ghcr.yml,docker-compose.web-update.yml
WEB_UPDATE_RUNNER_IMAGE=docker:27-cli
WEB_UPDATE_SERVICES=backend,frontend
WEB_UPDATE_PROXY_URL=
WEB_UPDATE_NO_PROXY=
WEB_UPDATE_ONLINE_VERSION_TIMEOUT_MS=5000

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password
